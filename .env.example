# Server-side only. Never place this key in browser JavaScript.
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemma-4-26b-a4b-it
# Optional alternate Gemma on Google for primary server errors. Empty disables.
GOOGLE_FALLBACK_MODEL=gemma-4-31b-it
# Optional shared access code for a private pilot.
TERMQUILL_ACCESS_CODE=
PORT=3000

# School accounts and shared review workspace (Supabase Marketplace integration)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# The integration may alternatively provide SUPABASE_ANON_KEY.
# Service-role and database passwords are NOT used by the app.

# Optional independent provider, server-side only
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional photo-reading model overrides (photos require vision-capable models)
GOOGLE_VISION_MODEL=gemma-4-26b-a4b-it
GROQ_VISION_MODEL=qwen/qwen3.8-27b
