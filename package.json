{
  "name": "lessonpress",
  "version": "0.1.0",
  "description": "Editable, source-linked assessments for tutors.",
  "main": "index.js",
  "directories": {
    "lib": "lib",
    "test": "test"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "test": "node --test",
    "check": "node --check server.js && node --check api/generate.js && node --check public/app.js",
    "models": "node --env-file-if-exists=.env scripts/models.js",
    "build": "node scripts/build.js"
  },
  "keywords": [],
  "author": "Paul Ayoade David",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@ai-sdk/google": "^4.0.98",
    "ai": "^7.0.142",
    "zod": "^4.6.7"
  },
  "private": true,
  "engines": {
    "node": ">=22.9"
  },
  "devDependencies": {
    "jsdom": "^30.1.3"
  }
}
